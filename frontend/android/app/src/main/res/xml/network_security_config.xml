<?xml version="1.0" encoding="utf-8"?>
<!--
  model_viewer_plus serves local .glb assets to its WebView through a small
  loopback HTTP server. Android 9+ blocks cleartext traffic by default, so
  this config narrowly allows it for localhost only — no external cleartext
  traffic is permitted, keeping the app's offline/no-network posture intact.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
