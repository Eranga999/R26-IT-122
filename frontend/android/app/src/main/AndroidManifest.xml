<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera permission for live landmark recognition -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Required so the WebView backing model_viewer_plus's AR arrow can reach
         its own loopback HTTP proxy (see network_security_config.xml) — without
         this the .glb model silently fails to load and only the ambient glow
         behind it is visible. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Location permissions for GPS-based landmark site lock -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Storage permission (needed on API < 33 for saving captures) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- Microphone permission for voice chat (speech-to-text) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Step counter/detector sensors for AR nav's surveyed-segment walking progress -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <!-- AR feature – not strictly required, enables AR-capable device filtering -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false"/>

    <application
        android:label="HeritageAR"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ARCore: optional means the app works without ARCore but can use it when available.
             This prevents the forced "Install ARCore" block on non-AR devices and emulators. -->
        <meta-data android:name="com.google.ar.core" android:value="optional"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required for speech_to_text plugin on Android 11+ (API 30+) -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
